{
  "realm": "opencommander",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "clientScopes": [
    {"name": "computer:read", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Read information on paired Windows devices"}},
    {"name": "computer:control", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Request actions on paired Windows devices, subject to local policy"}},
    {"name": "offline_access", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "true", "consent.screen.text": "Maintain access to paired devices when you are away"}}
  ],
  "clients": [
    {"clientId": "opencommander-mcp", "name": "OpenCommander MCP resource", "enabled": true, "protocol": "openid-connect", "bearerOnly": true, "attributes": {"resource_url": "${OPENCOMMANDER_MCP_RESOURCE}"}},
    {
      "clientId": "opencommander-chatgpt",
      "name": "OpenCommander ChatGPT",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${OPENCOMMANDER_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": ["https://chatgpt.com/connector_platform_oauth_redirect", "http://127.0.0.1:18123/callback"],
      "webOrigins": ["https://chatgpt.com"],
      "attributes": {"pkce.code.challenge.method": "S256", "use.refresh.tokens": "true"},
      "defaultClientScopes": ["computer:read"],
      "optionalClientScopes": ["computer:control", "offline_access"],
      "protocolMappers": [
        {"name": "Stable owner subject", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "consentRequired": false, "config": {"id.token.claim": "true", "access.token.claim": "true", "introspection.token.claim": "true"}},
        {"name": "MCP resource audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": {"included.custom.audience": "${OPENCOMMANDER_MCP_RESOURCE}", "id.token.claim": "false", "access.token.claim": "true", "introspection.token.claim": "true"}}
      ]
    }
  ],
  "users": [
    {"username": "owner", "firstName": "Owner", "lastName": "OpenCommander", "email": "owner@opencommander.invalid", "enabled": true, "emailVerified": false, "credentials": [{"type": "password", "value": "${OPENCOMMANDER_OWNER_PASSWORD}", "temporary": false}]}
  ]
}
